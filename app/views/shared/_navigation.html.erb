<aside class="hidden md:flex w-72 flex-col bg-zinc-950 border-r border-zinc-800/50 backdrop-blur-xl">
  <div class="p-6 border-b border-zinc-800/50">
    <h1 class="text-lg font-bold text-zinc-100 flex items-center gap-2 tracking-tight">
      <span class="w-2 h-2 bg-zinc-500 rounded-full"></span>
      DocuAsk
    </h1>
  </div>
  
  <div class="flex-1 overflow-y-auto p-4 space-y-1">
    <div class="text-[10px] font-bold text-zinc-600 uppercase tracking-[0.2em] px-2 mb-4">Archive</div>
    <% @conversations.each do |conv| %>
      <%= link_to conversation_path(conv), 
          class: "block p-3 rounded-lg transition-all #{conv == @conversation ? 'bg-zinc-900 border border-zinc-800 text-zinc-100' : 'hover:bg-zinc-900/50 text-zinc-500 hover:text-zinc-300'}" do %>
        <div class="text-xs font-medium truncate">
          <%= conv.documents.first&.context_file&.filename || "Untitled Chat" %>
        </div>
        <div class="text-[9px] font-mono opacity-50 mt-1 uppercase"><%= time_ago_in_words(conv.created_at) %></div>
      <% end %>
    <% end %>
  </div>

  <div class="p-4 border-t border-zinc-800/50">
    <%= link_to "New Chat", root_path, class: "flex items-center justify-center w-full py-2.5 bg-zinc-100 hover:bg-white text-zinc-950 rounded-lg text-xs font-bold transition-all" %>
  </div>
</aside>