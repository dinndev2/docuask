<div class="w-full h-screen flex bg-zinc-950 text-zinc-300 font-sans overflow-hidden">
  
  <%= render partial: "shared/navigation" %>

  <div class="flex-1 flex flex-col relative h-full">  
    <header class="h-16 border-b border-zinc-800/50 flex justify-between items-center px-8 shrink-0">
      <div class="flex items-center gap-3">
        <span class="text-[10px] font-mono text-zinc-500">SESSION:</span>
        <h2 class="text-xs font-bold text-zinc-100 uppercase tracking-tight truncate max-w-[300px]">
          <%= @conversation.documents.first&.context_file&.filename %>
        </h2>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Vector_Live</span>
      </div>
    </header>

    <div id="chat-messages" class="flex-1 overflow-y-auto p-6 md:p-12 scroll-smooth">
      <div class="max-w-3xl mx-auto w-full space-y-10">
        
        <div class="flex gap-4 mb-16 opacity-60">
          <div class="text-[10px] font-mono text-zinc-500 shrink-0 mt-1">[SYS]</div>
          <div class="text-xs leading-relaxed font-mono">
            Protocol initialized. Context chunks embedded. Vector distance thresholds set.
          </div>
        </div>

        <div id="responses" class="space-y-8 flex flex-col">
          <%= turbo_stream_from "responses" %>
          <%= render @responses %>
        </div>

        <div id="thinking-container" class="mt-8 min-h-[40px]">
          <%= turbo_stream_from "thinking_stream_container" %>
        </div> 

        <div class="h-32"></div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-zinc-950 via-zinc-950/90 to-transparent">
      <div class="max-w-3xl mx-auto relative group">
        <%= form_with url: ask_conversation_path(@conversation), 
                      class: "relative", 
                      data: { controller: "chat", action: "turbo:submit-end->chat#reset" } do |f| %>
          
          <%= f.text_field :query,
              placeholder: "EXECUTE QUERY...", 
              class: "w-full bg-zinc-900 border border-zinc-800 rounded-xl py-4 pl-5 pr-14 text-sm font-mono focus:outline-none focus:border-zinc-500 transition-all placeholder:text-zinc-700 text-zinc-200" %>
          
          <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-zinc-600 hover:text-zinc-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>