<div class="w-full h-screen flex bg-zinc-950 text-zinc-300 font-sans overflow-hidden">
  <%= render partial: "shared/navigation" %>

  <div data-controller="chat" class="flex-1 flex flex-col relative h-full">  
    <header class="h-16 border-b border-zinc-800/50 flex justify-between items-center px-8 shrink-0">
      <div class="flex items-center gap-3">
        <span class="text-[10px] font-mono text-zinc-500">SESSION:</span>
        <h2 class="text-xs font-bold text-zinc-100 uppercase tracking-tight truncate max-w-[300px]">
          <%= @conversation.documents.first&.context_file&.filename %>
        </h2>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Vector_Live</span>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto p-6 md:p-12 scroll-smooth" data-chat-target="responses" >
      <div class="max-w-3xl mx-auto w-full space-y-10">
        <div class="flex gap-4 mb-16 opacity-60">
          <div class="text-[10px] font-mono text-zinc-500 shrink-0 mt-1">[SYS]</div>
          <div class="text-xs leading-relaxed font-mono">
            Protocol initialized. Context chunks embedded. Vector distance thresholds set.
          </div>
        </div>

        <div id="responses" class="space-y-8 flex flex-col">
          <%= turbo_stream_from "responses" %>
          <%= render @responses %>
        </div>

        <div id="thinking_stream_container"> 
          <%= turbo_stream_from "thinking_stream_container" %>
          <div id="thinking-container"></div> 
        </div>

        <div class="h-48"></div> </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-zinc-950 from-80% via-zinc-950/100 to-transparent">
      <div class="max-w-3xl mx-auto flex flex-col gap-4"> 

          <span class="text-[8px] font-mono text-blue-500 font-bold uppercase tracking-[0.2em] shrink-0">
            Suggestions:
          </span>
        
          <div class="flex gap-2 items-center flex-wrap" id="questions">
            <% if @sample_questions.blank? %>
              <span class="text-[8px] font-mono text-yellow-500 font-bold uppercase tracking-[0.2em] shrink-0">
                Generating Sample Questions...
              </span>
            <% end %>
            <%= render partial: "sample_questions/sample_question",
                       collection: @sample_questions,
                       locals: { conversation: @conversation } %>
          </div>
          <%= turbo_stream_from @conversation %>


        <%= form_with url: ask_conversation_path(@conversation), 
                      class: "flex flex-col gap-2", 
                      data: { action: "turbo:submit-end->chat#reset" } do |f| %>
          
          <div class="flex justify-between items-center px-1">
            <div class="flex items-center gap-3">
              <span class="text-[8px] font-mono text-zinc-700 uppercase tracking-widest">Active_Model:</span>
              <%= f.select :model_name, 
                  Conversation::AI_MODELS.map { |m| [m.titleize, m] }, 
                  {}, 
                  { class: "bg-transparent text-[9px] font-mono text-zinc-500 border-none p-0 focus:ring-0 cursor-pointer hover:text-zinc-300 transition-colors uppercase tracking-tighter" } 
              %>
            </div>
            <span class="text-[8px] font-mono text-zinc-800 uppercase tracking-widest">Encrypted_Link</span>
          </div>

          <div class="relative">
            <%= f.text_field :query,
                placeholder: "EXECUTE QUERY...", 
                class: "w-full bg-transparent border-b border-zinc-900 focus:border-zinc-700 py-4 px-1 text-xs font-mono focus:outline-none transition-all duration-700 placeholder:text-zinc-800 text-zinc-300" %>
            
            <button type="submit" class="absolute right-0 top-1/2 -translate-y-1/2 p-2 text-zinc-700 hover:text-zinc-400 transition-all duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </div>

          <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-zinc-900 to-transparent opacity-50"></div>
        <% end %>
      </div>
    </div>
  </div>
</div>