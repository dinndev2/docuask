<div class="w-full h-full flex flex-col bg-[#0b0f1a] text-slate-300 font-sans">
  
  <header class="w-full p-5 bg-slate-900/40 backdrop-blur-md border-b border-white/5 flex justify-between items-center z-10">
    <div class="flex items-center gap-4">
      <div class="w-8 h-8 rounded-lg bg-slate-800 border border-white/10 flex items-center justify-center">
        <span class="text-[10px] font-bold text-slate-500">DOC</span>
      </div>
      <div>
        <h2 class="text-xs font-bold text-white uppercase tracking-tight truncate max-w-[250px]">
          <%= @conversation.documents.first&.context_file&.filename %>
        </h2>
        <p class="text-[9px] text-slate-500 font-mono tracking-widest uppercase">Index // Active</p>
      </div>
    </div>
    
    <%= link_to root_path, class: "p-2 hover:bg-white/5 rounded-md transition-colors text-slate-500" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    <% end %>
  </header>

  <div id="chat-messages" class="flex-1 overflow-y-auto p-6 md:p-12 space-y-10 scroll-smooth">
    <div class="max-w-3xl mx-auto w-full">
      
      <div class="flex gap-4 mb-12">
        <div class="w-8 h-8 rounded-md bg-slate-800 border border-white/10 flex items-center justify-center shrink-0 font-mono text-[10px] text-indigo-400">AI</div>
        <div class="text-sm leading-relaxed text-slate-400 max-w-2xl">
          Protocol initialized. Context chunks loaded into <span class="text-white font-mono">pgvector</span>. Awaiting query.
        </div>
      </div>
      <div id="responses" class="space-y-8 flex flex-col gap-2">
        <%= turbo_stream_from "responses" %>
        <%= render @responses %>
      </div>
      <div id="thinking_stream_container"> 
        <%= turbo_stream_from "thinking_stream_container" %>
        <div id="thinking-container" class="">
        </div> 
      </div>
    </div>
  </div>

  <div class="p-6 md:pb-10 w-full max-w-3xl mx-auto">
    <%= form_with url: ask_conversation_path(@conversation), 
                  class: "relative group", 
                  data: { controller: "chat", action: "turbo:submit-end->chat#reset" } do |f| %>
      
      <%= f.text_field :query,
          placeholder: "INPUT QUERY...", 
          class: "w-full bg-slate-900/50 border border-white/5 rounded-xl py-4 pl-5 pr-14 text-sm font-mono focus:outline-none focus:border-indigo-500/50 transition-all placeholder:text-slate-700 text-slate-200" %>
      
      <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-slate-500 hover:text-indigo-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    <% end %>
  </div>
</div>