<div id="context-upload" class="w-full">
  <%= form_with model: conversation, class: "space-y-6" do |f| %>
    
    <div class="relative group">
      <label class="flex flex-col items-center justify-center w-full h-72 border-2 border-dashed border-slate-700 hover:border-indigo-500 rounded-[2rem] cursor-pointer bg-slate-900/50 hover:bg-slate-900 transition-all duration-500">
        <div class="flex flex-col items-center justify-center text-center p-8">
          <div class="w-20 h-20 bg-indigo-500/10 rounded-3xl flex items-center justify-center text-indigo-400 group-hover:scale-110 group-hover:bg-indigo-500 group-hover:text-white transition-all duration-500 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          </div>
          
          <span class="text-sm font-bold text-white mb-1">Upload Context File</span>
          <p id="file-name-hint" class="text-xs text-slate-500 tracking-wide">
            PDF, DOCX, or TXT
          </p>
        </div>

        <%= f.fields_for :documents, conversation.documents.build do |doc_form| %>
          <%= doc_form.file_field :context_file, class: "hidden", 
            onchange: "document.getElementById('file-name-hint').innerText = this.files[0].name.toUpperCase(); document.getElementById('file-name-hint').classList.add('text-indigo-400', 'font-bold');" %>
        <% end %> 
      </label>
    </div>

    <% if conversation.errors.any? %>
      <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-2xl">
        <% conversation.errors.full_messages.each do |msg| %>
          <div class="text-[10px] font-bold text-red-400 uppercase tracking-widest flex items-center gap-2">
            <span class="w-1 h-1 bg-red-400 rounded-full"></span> <%= msg %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= f.submit "Initialize Room", 
        class: "w-full py-5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-black uppercase tracking-widest rounded-2xl shadow-xl shadow-indigo-500/20 active:scale-[0.98] transition-all cursor-pointer" %>
  <% end %>
</div>