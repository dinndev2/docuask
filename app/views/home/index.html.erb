<div class="min-h-screen bg-zinc-950 text-zinc-200 font-sans flex overflow-hidden">
  
  <%= render partial: "shared/navigation" %>

  <main class="flex-1 relative flex flex-col items-center justify-center overflow-hidden">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-zinc-500/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-white/5 blur-[120px] rounded-full"></div>

    <div class="w-full max-w-xl px-6 animate-in fade-in duration-1000">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-white tracking-tighter">Vector Context</h2>
        <p class="text-zinc-500 mt-3 font-mono text-xs uppercase tracking-widest">Document Analysis Protocol</p>
      </div>
      
      <div class="bg-zinc-900/50 backdrop-blur-2xl border border-zinc-800 p-10 rounded-[2rem]">
        <%= render "conversations/form", conversation: @conversation %>
      </div>
    </div>
  </main>
</div>