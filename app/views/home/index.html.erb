<div class="min-h-screen bg-zinc-950 text-zinc-500 font-sans flex overflow-hidden">
  
  <%= render partial: "shared/navigation" %>

  <main class="flex-1 relative flex flex-col items-center justify-center">
    <div class="absolute top-[-5%] left-[-5%] w-[40%] h-[40%] bg-zinc-500/5 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-[-5%] right-[-5%] w-[40%] h-[40%] bg-zinc-400/5 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="w-full max-w-lg px-8 z-10 animate-in fade-in duration-1000">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-light text-zinc-200 tracking-tighter mb-2">
          Vector Context
        </h2>
        <p class="text-[9px] font-mono text-zinc-600 uppercase tracking-[0.4em]">
          Isolated_Instance // Local
        </p>
      </div>
      
      <div class="bg-zinc-950/40 backdrop-blur-sm border border-zinc-900/80 p-12 rounded-[3rem]">
        <%= render "conversations/form", conversation: @conversation %>
      </div>

      <div class="flex items-center justify-center gap-4 mt-10 opacity-30">
        <span class="h-[1px] w-4 bg-zinc-800"></span>
        <p class="text-[8px] font-mono text-zinc-500 uppercase tracking-widest">
          pgvector storage active
        </p>
        <span class="h-[1px] w-4 bg-zinc-800"></span>
      </div>
    </div>
    
  </main>
</div>