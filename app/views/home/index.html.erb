<div class="min-h-screen bg-[#0f172a] text-slate-200 font-sans selection:bg-indigo-500/30 flex overflow-hidden">
  
  <aside class="hidden md:flex w-72 flex-col bg-slate-900/50 border-r border-white/5 backdrop-blur-xl">
    <div class="p-6 border-b border-white/5">
      <h1 class="text-xl font-bold text-white flex items-center gap-2">
        <span class="w-3 h-3 bg-indigo-500 rounded-full animate-pulse"></span>
        DocuAsk
      </h1>
    </div>
    
    <div class="flex-1 overflow-y-auto p-4 space-y-2">
      <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-2 mb-4">History</div>
      <% @conversations.each do |conv| %>
        <%= link_to conversation_path(conv), class: "block p-3 rounded-xl transition-all #{conv == @active_conversation ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-500/20' : 'hover:bg-white/5 text-slate-400'}" do %>
          <div class="text-sm font-medium truncate">
            <%= conv.documents.first&.context_file&.filename || "Untitled Chat" %>
          </div>
          <div class="text-[10px] opacity-60 mt-1"><%= time_ago_in_words(conv.created_at) %> ago</div>
        <% end %>
      <% end %>
    </div>

    <div class="p-4 border-t border-white/5">
      <%= link_to "New Chat", root_path, class: "flex items-center justify-center w-full py-3 bg-white/5 hover:bg-white/10 rounded-xl text-sm font-bold transition-all border border-white/10" %>
    </div>
  </aside>

  <main class="flex-1 relative flex flex-col items-center justify-center overflow-hidden">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-500/10 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-purple-500/10 blur-[120px] rounded-full"></div>
    <div class="w-full max-w-xl px-6 animate-in fade-in zoom-in duration-700">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-extrabold text-white tracking-tight">Ready to analyze?</h2>
        <p class="text-slate-400 mt-2">Upload a document to start a new conversation room.</p>
      </div>
      
      <div class="bg-slate-800/40 backdrop-blur-2xl border border-white/10 p-8 rounded-[2rem] shadow-2xl">
        <%= render "conversations/form", conversation: @conversation %>
      </div>
    </div>
  </main>
</div>